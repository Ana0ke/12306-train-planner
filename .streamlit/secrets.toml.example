# 12306省心小助手 - Streamlit Cloud Secrets 配置模板
# 在 Streamlit Cloud 的 Settings → Secrets 中添加以下内容
# 不要将真实密钥提交到代码仓库！

# LLM API配置（用于AI旅行规划）
LLM_API_KEY = "your_api_key_here"
LLM_BASE_URL = "https://api.deepseek.com"
LLM_MODEL = "deepseek-chat"

# 查询模式开关（默认：真实查询，失败自动fallback到Demo）
# 设置 DEMO_MODE = "true" 可强制使用Demo数据
# 设置 USE_REALTIME = "false" 可禁用真实查询
# DEMO_MODE = "true"
# USE_REALTIME = "false"
