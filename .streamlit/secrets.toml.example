# 12306省心小助手 - Streamlit Cloud Secrets 配置模板
# 在 Streamlit Cloud 的 Settings → Secrets 中添加以下内容
# 不要将真实密钥提交到代码仓库！

# LLM API配置（用于AI旅行规划）
LLM_API_KEY = "your_api_key_here"
LLM_BASE_URL = "https://api.deepseek.com"
LLM_MODEL = "deepseek-chat"

# Demo模式开关
DEMO_MODE = "true"

# MCP服务配置（可选，配置后启用真实12306数据查询）
# 本地部署 mcp-server-12306 后填写地址
# 例如: http://localhost:8000
MCP_SERVER_URL = ""
